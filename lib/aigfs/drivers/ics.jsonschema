{
  "properties": {
    "aigfs_ics": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "files_to_copy": {
              "minProperties": 1,
              "patternProperties": {
                "^data/": {}
              },
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "files_to_hardlink": {
              "minProperties": 1,
              "patternProperties": {
                "^data/": {}
              },
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "files_to_link": {
              "minProperties": 1,
              "patternProperties": {
                "^data/": {}
              },
              "type": "object"
            }
          }
        }
      ],
      "description": "Schema for the AIGFSICs driver config",
      "properties": {
        "execution": {
          "$ref": "urn:uwtools:execution-serial",
          "description": "Settings for driver execution"
        },
        "files_to_copy": {
          "$ref": "urn:uwtools:files-to-stage",
          "description": "Files to copy into the driver run directory"
        },
        "files_to_hardlink": {
          "$ref": "urn:uwtools:files-to-stage",
          "description": "Files to hardlink into the driver run directory"
        },
        "files_to_link": {
          "$ref": "urn:uwtools:files-to-stage",
          "description": "Files to symlink into the driver run directory"
        },
        "rundir": {
          "description": "Path to the driver run directory",
          "type": "string"
        },
        "variable_extraction_yaml": {
          "description": "Path to the YAML file defining variables for GRIB -> netCDF extraction",
          "type": "string"
        }
      },
      "required": [
        "execution",
        "rundir",
        "variable_extraction_yaml"
      ],
      "type": "object"
    }
  },
  "required": [
    "aigfs_ics"
  ],
  "type": "object"
}
