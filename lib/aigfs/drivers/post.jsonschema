{
  "properties": {
    "aigfs_post": {
      "additionalProperties": false,
      "description": "Schema for the AIGFSPost driver config",
      "properties": {
        "deliver_to": {
          "description": "Directory to deliver GRIB index to after creation",
          "type": "string"
        },
        "execution": {
          "$ref": "urn:uwtools:execution-serial",
          "description": "Settings for driver execution"
        },
        "inputfiles": {
          "description": "Paths to GRIB files to index",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "type": "array"
        },
        "outputdir": {
          "description": "Directory to write GRIB index files to",
          "type": "string"
        },
        "rundir": {
          "description": "Path to the driver run directory",
          "type": "string"
        }
      },
      "required": [
        "execution",
        "inputfiles",
        "outputdir",
        "rundir"
      ],
      "type": "object"
    }
  },
  "required": [
    "aigfs_post"
  ],
  "type": "object"
}
