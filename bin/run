#!/usr/bin/env -S bash -aeuo pipefail

# Export CONDADIR to specify alternate conda install path.
# Export DEVMODE to install development packages.

# Tools:

bootstrap() {
  local condadir env rootdir
  condadir=$(condadir)
  env=$(env)
  rootdir=$(rootdir)
  if [[ -d $condadir ]]; then
    msg Using existing conda: $condadir
  else
    msg Installing conda to $condadir
    (
      os=$(uname)
      test $os == Darwin && os=MacOSX
      machine=$(uname -m)
      installer=Miniforge3-$os-$machine.sh
      version=26.3.2-3
      curl -sSLO https://github.com/conda-forge/miniforge/releases/download/$version/$installer
      bash $installer -bfp $condadir
      rm -v $installer
      activate base
      conda install --quiet --yes ansible=14.2.*
    )
    msg Installed conda to $condadir
  fi
}

makedocs() {
  local rootdir
  rootdir=$(rootdir)
  activate $(env)
  (set -x && pdoc --output-dir $rootdir/docs/api $rootdir/drivers)
  conda deactivate
}

makeenv() {
  local condadir env
  condadir=$(condadir)
  env=$(env)
  bootstrap
  activate base
  export PIP_VERBOSE=1
  export XDG_CACHE_HOME=$(condadir)/cache
  if [[ -d $condadir/envs/$env ]]; then
    msg Using existing environment $env
  else
    msg Creating environment $env
    conda env create --quiet --yes --file $(envyaml)
    msg Created environment $env
  fi
  if [[ -v DEVMODE ]]; then
    msg Installing dev packages into environment $env
    conda env update --quiet --file $(dirname $(envyaml))/devpkgs.yaml --name $env
    msg Installed dev packages into environment $env
  fi
  unset PIP_VERBOSE XDG_CACHE_HOME
}

format() {
  local js py
  test $# -eq 0 && echo "usage: $(basename $0) path [path ...]" && exit 1
  activate $(env)
  msg Formatting Python code
  py=( $(printf "$(rootdir)/%s " drivers tests ush) )
  ruff format ${py[@]}
  msg Sorting Python imports
  ruff check --select I --fix ${py[@]}
  msg Formatting JSON
  js=( $(printf "$(rootdir)/%s " drivers) )
  for f in $(find ${js[@]} -type f -name "*.json" -o -name "*.jsonschema"); do
    jq -S . $f >$f.new || (echo "    in $f" && rm $f.new && false)
    cmp --quiet $f.new $f && rm $f.new || mv $f.new $f
  done
  conda deactivate
}

lint() {
  activate $(env)
  msg Linting Python code
  ruff check $(rootdir)
  conda deactivate
}

msg() {
  echo "=> $@"
}

rmenv() {
  local env
  env=$(env)
  activate base
  msg Removing environment $env
  conda env remove --yes --name $env
  msg Removed environment $env
}

typecheck() {
  activate $(env)
  msg Typechecking Python code
  mypy $@
  conda deactivate
}

unittest() {
  activate $(env)
  msg Running Python unit tests
  pytest --cov $(rootdir)/tests
  conda deactivate
}

# Helpers:

activate() {
  local env
  env=$1
  . $(condadir)/etc/profile.d/conda.sh
  export CONDARC=$(rootdir)/.condarc
  conda activate $env
}

condadir() {
  echo ${CONDADIR:-$(rootdir)/conda}
}

env() {
  sed -n '/^name:.*/ s/^name: *//p' $(envyaml)
}

envyaml() {
  echo $(rootdir)/envs/environment.yaml
}

rootdir() {
  git rev-parse --show-toplevel
}

# Main entrypoint:

test $# -eq 0 && echo "usage: $(basename $0) tool [args ...]" && exit 1
tool=$1
shift
$tool $@
